{
  "manifest_version": 3,
  "name": "MassSelect",
  "version": "1.0",

  "description": "Adds a checkbox to item rows to enable bulk delete in *.circlly.com/favorites.",

  "icons": {
    "48": "icons/icons8-plus-sign-48.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.circlly.com/favorites*"],
      "js": ["massSelect.js"]
    }
  ],

  "permissions" : ["*://*.circlly.com/favorites"],

  "browser_specific_settings": {
  "gecko": {
    "id": "@circlly-mass-select.nomi",
    "data_collection_permissions": {
      "required": [
        "websiteActivity",
        "websiteContent"
      ]
    },
    "strict_min_version": "140.0"
          }
  }
}